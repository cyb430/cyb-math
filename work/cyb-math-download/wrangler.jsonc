{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyb-math-download",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "download.cyb-math.cn",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "vars": {
    "BAIDU_SHARE_URL": "https://pan.baidu.com/s/1HOlhpnb_63O-GX17Z-R_SQ?pwd=math",
    "BAIDU_EXTRACT_CODE": "math"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
